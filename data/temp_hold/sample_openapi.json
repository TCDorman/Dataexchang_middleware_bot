{
  "openapi": "3.0.0",
  "info": {
    "title": "Customer Orders API",
    "version": "1.0"
  },
  "paths": {
    "/orders": {
      "get": {
        "summary": "Get customer orders",
        "responses": {
          "200": {
            "description": "List of orders",
            "content": {
              "application/json": {
                "example": [
                  {
                    "purchaseOrderNumber": "PO-1001",
                    "buyerName": "Ford",
                    "sku": "ABC123",
                    "requestedQuantity": 5
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}